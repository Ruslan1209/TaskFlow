
@startuml
title Последовательность «Добавить задачу»

participant "user : User" as u
participant "main : Программа" as app
participant "factory : TaskFactory" as factory
participant "task : Task" as task
participant "list : TaskList" as list

u -> app : выбрать «Добавить задачу», тип
app -> factory : create(type)
activate factory
factory --> app : task : Task
deactivate factory

u -> app : название, описание, приоритет, дата, теги
app -> task : setTitle(title)
app -> task : setDescription(description)
app -> task : setPriority(priority)
app -> task : setDate(date)
app -> task : setTags(tags)

app -> list : addTask(task)
activate list
list -> task : setId(nextId)
list --> app : номер задачи
deactivate list

app --> u : «Задача создана, номер N»
@enduml
