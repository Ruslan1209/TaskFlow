@startuml 04_deployment
title Диаграмма развертывания TaskFlow

node "Компьютер пользователя" as PC {
  node "ОС: Windows / Linux" as OS {
    artifact "task_manager\n(исполняемый файл)" as Exe
    artifact "tasks.csv\n(файл задач)" as Tasks
    artifact "settings.ini\n(файл настроек)" as Cfg
  }
}
Exe --> Tasks : файловый ввод-вывод\n(локальный диск)
Exe --> Cfg : чтение формата хранилища\n(локальный диск)
@enduml
