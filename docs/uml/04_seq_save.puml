@startuml 04_seq_save
title Диаграмма последовательности: "Сохранить и загрузить список"

actor Пользователь as U
participant ":Menu\n(main.cpp)" as M
participant "st: ITaskStorage" as I
participant ":TaskList" as L
participant "t: Task" as T

== Сохранение ==
U -> M : выбрать пункт «Сохранить»
activate M
M -> I : save(список, путь к файлу задач)
activate I
alt [файл открылся успешно]
  loop [по каждой задаче t в списке]
    I -> T : getTitle(), getDescription(), getDate(),\ngetPriority(), getStatus(), getTags(), typeName()
    T --> I : значения полей
    I -> I : serializeTask(t) — строка формата\nтип;номер;название;описание;дата;приоритет;статус;интервал;теги
  end
  I --> M : истина (записано N задач)
else [файл не открылся]
  I --> M : ложь
  M --> U : «Ошибка записи файла»
end
M --> U : «Список сохранён»
deactivate I
deactivate M

== Загрузка ==
U -> M : выбрать пункт «Загрузить»
activate M
M -> I : load(список, путь к файлу задач)
activate I
alt [файл найден и открылся]
  loop [по каждой строке файла]
    I -> I : applyTaskLine(список, строка)
    I -> L : addTask(t)
    activate L
    L --> I : задача добавлена
    deactivate L
  end
  I --> M : количество загруженных задач N
  M --> U : «Загружено N задач»
else [файл не найден]
  I --> M : -1
  M --> U : «Ошибка: файл не найден»
end
deactivate I
deactivate M

note over I
  {временное ограничение}
  сохранение 1000 задач <= 1 сек
end note
@enduml
