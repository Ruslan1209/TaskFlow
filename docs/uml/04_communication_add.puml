@startuml 04_communication_add
title Кооперация: "Добавить задачу"

left to right direction
object ":Меню" as M
object ":TaskService" as S
object "t: Задача" as T
object ":TaskList" as L

M -> S : 1: addTask(title, priority)
S -> S : 1.1: [заголовок не пуст,\n1 <= приоритет <= 5]\nvalidate(заголовок, приоритет)
S -> T : 1.2: <<create>> Task(title, priority)
S -> L : 1.3: add(t)
S --> M : 1.4: результат (истина/ложь)
@enduml
