@startuml 04_communication_add
title Кооперация: "Добавить задачу"

left to right direction
object ":Меню" as M
object "f: TaskFactory" as F
object "t: Task" as T
object ":TaskList" as L
object ":AppSettings" as A
object "s: ITaskStorage" as S

M -> F : 1: [данные верные] create(тип)
F --> M : 1.1: t: Task
M -> T : 1.2: setTitle(название)
M -> T : 1.3: setDescription(описание)
M -> T : 1.4: setPriority(приоритет)
M -> T : 1.5: setDate(дата)
M -> T : 1.6: setTags(теги)
M -> L : 1.7: addTask(t)
M -> A : 1.8: getStorageFormat()
M -> S : 1.9: [формат выбран] save(список)
S --> M : 1.10: истина
M --> M : 1.11: показать «Задача создана, номер N»
@enduml
