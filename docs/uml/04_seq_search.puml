@startuml 04_seq_search
title Диаграмма последовательности: "Найти задачи"

actor Пользователь as U
participant ":Menu\n(main.cpp)" as M
participant "f: TaskFilter" as F
participant ":TaskList" as L
participant "t: Task" as T

U -> M : выбрать пункт «Найти задачи»
activate M
M -> M : ввод критерия поиска
M -> F : <<create>> TaskFilter
M -> F : setTag(тег) / setDate(дата) /\nsetPriority(приоритет)

M -> L : all()
activate L
L --> M : список всех задач
deactivate L

loop [по каждой задаче t из списка]
  M -> F : matches(t)
  activate F
  alt [задан тег]
    F -> T : matchesTag(tag)
    T --> F : истина / ложь
  end
  alt [задана дата]
    F -> T : matchesDate(date)
    T --> F : истина / ложь
  end
  alt [задан приоритет]
    F -> T : matchesPriority(priority)
    T --> F : истина / ложь
  end
  F --> M : истина / ложь
  deactivate F
  M -> M : [matches = истина] добавить t в результаты
end

alt [результаты не пусты — задачи найдены]
  M --> U : «Найдено N задач» + список
else [результаты пусты]
  M --> U : «Ничего не найдено»
end
deactivate M
@enduml
