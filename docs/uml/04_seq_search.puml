@startuml 04_seq_search
title Диаграмма последовательности: "Найти задачи"

actor Пользователь as U
participant ":Menu\n(main.cpp)" as M
participant "f: TaskFilter" as F
participant ":TaskList" as L
participant "t: Task" as T

U -> M : выбрать пункт «Найти задачи»
activate M
M -> M : ввод слова поиска

M -> L : all()
activate L
L --> M : список всех задач
deactivate L

loop [по каждой задаче t из списка]
  M -> F : filter(t, слово поиска)
  activate F
  F -> T : getTitle(), getStatus(), getTags()
  T --> F : значения полей
  F --> M : истина / ложь
  deactivate F
  alt [фильтр вернул истину — задача подходит]
    M -> M : добавить t в результаты
  end
end

alt [результаты не пусты — задачи найдены]
  M --> U : «Найдено N задач» + список
else [результаты пусты]
  M --> U : «Ничего не найдено»
end
deactivate M
@enduml
