@startuml
title Диаграмма состояний задачи (TaskFlow)

state "Новая" as New
state "Активна" as Active {
  state "В работе" as InWork
  state "Приостановлена" as Paused
  InWork --> Paused : pause()
  Paused --> InWork : start()
}
state "Просрочена" as Overdue
state "Выполнена" as Done
state "Отменена" as Cancelled
state "В архиве" as Archived

[*] --> New : addTask()\n/ setStatus(NEW)
New --> Active : start(today)\n[дата не в прошлом]
Active --> Overdue : check(today)\n[срок прошёл]
Active --> Done : markDone(today)\n/ setCompletedDate(today)
Overdue --> Done : markDone(today)\n/ setCompletedDate(today)
Overdue --> InWork : start(today)
New --> Cancelled : cancel()
Active --> Cancelled : cancel()
Done --> Archived : archive()\n/ saveToStorage()
Overdue --> Archived : archive()\n/ saveToStorage()
Cancelled --> Archived : archive()\n/ saveToStorage()
Archived --> [*]

New : entry / setStatus(NEW)
Done : entry / setCompletedDate(today)
Archived : exit / saveToStorage()
@enduml
