' ================== OBSERVER ==================
package "Observer (реакция на изменения)" {

  enum TaskEventType {
    Added
    Changed
    Removed
  }

  interface TaskObserver <<Observer>> {
    +~TaskObserver()
    +{abstract} onTaskEvent(type : TaskEventType, task : Task&) : void
  }

  class AutoSaveObserver <<ConcreteObserver>> {
    +onTaskEvent(type : TaskEventType, task : Task&) : void
  }

  class DeadlineObserver <<ConcreteObserver>> {
    +onTaskEvent(type : TaskEventType, task : Task&) : void
  }

  class TaskListSubject <<Subject>> {
    -observers_ : vector<TaskObserver*>
    +subscribe(o : TaskObserver*) : void
    +unsubscribe(o : TaskObserver*) : void
    -notifyAll(type : TaskEventType, task : Task&) : void
  }

  TaskObserver <|.. AutoSaveObserver
  TaskObserver <|.. DeadlineObserver
  TaskListSubject o-- TaskObserver : подписчики
}

TaskListSubject <|-- TaskList
