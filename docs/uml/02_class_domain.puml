@startuml 02_class_domain
skinparam classAttributeIconSize 0
title Диаграмма классов TaskFlow (обновлённая, ДЗ-4)

class Menu {
  - choice : int
  + run() : void
  + show() : void
  + readInput() : string
}

class TaskService {
  - lists : vector<TaskList*>
  + addTask(title : string, priority : int) : bool
  + findTasks(keyword : string) : vector<Task*>
  + saveAll(file : string) : bool
  + loadAll(file : string) : bool
}

class User {
  - name : string
}

class TaskList {
  - tasks : vector<Task*>
  + add(t : Task*) : void
  + remove(t : Task*) : void
  + getAll() : vector<Task*>
  + count() : int
}

abstract class Task {
  # title : string
  # priority : int
  - done : bool
  + markDone() : void
  + getTitle() const : string
  + matches(keyword : string) const : bool
  + {abstract} describe() const : string
}

class DeadlineTask {
  - deadline : string
  + describe() const : string
}

class Tag {
  - name : string
}

class TaskPrinter {
  + print(t : const Task&) const : void
}

interface ITaskStorage {
  + {abstract} save(tasks : vector<Task*>, file : string) : bool
  + {abstract} load(file : string) : vector<Task*>
}

class TxtStorage {
  + save(tasks : vector<Task*>, file : string) : bool
  + load(file : string) : vector<Task*>
}

User "1" --> "*" TaskList : владеет
TaskList "1" *-- "*" Task : хранит
Task o-- "*" Tag : помечена
Task <|-- DeadlineTask
TaskPrinter ..> Task : печатает
TaskService "*" --> "*" TaskList : управляет
TaskService ..> ITaskStorage : использует
TxtStorage .up.|> ITaskStorage : реализует
Menu "1" --> "1" TaskService : вызывает
@enduml
