
@startuml
title TaskFlow — доменная модель (обновлено на ДЗ-07)

skinparam classAttributeIconSize 0

enum Priority {
  High
  Medium
  Low
}

enum Status {
  New
  InProgress
  Done
}

class Task <<Abstract>> {
  #id : int
  #title : string
  #description : string
  #date : string
  #priority : Priority
  #status : Status
  #tags : vector<string>
  +getId() / getTitle() / getDate() ...
  +setTitle(...)/setDescription(...)/setDate(...)
  +setPriority(...)/setStatus(...)/setTags(...)
  +typeName() : string
  +extraInfo() : string
  +clone() : Task*
}

class RecurringTask {
  -interval : int
  +setInterval(int)
  +extraInfo() : string
}

class TaskBuilder {
  +forType(type) : TaskBuilder&
  +title(t) : TaskBuilder&
  +description(d) : TaskBuilder&
  +priority(p) : TaskBuilder&
  +date(d) : TaskBuilder&
  +tags(line) : TaskBuilder&
  +interval(days) : TaskBuilder&
  +build() : unique_ptr<Task>
}

class TaskFactory <<Factory Method>> {
  {static} +instance() : TaskFactory&
  +typeNames() : vector<string>
  +create(type) : unique_ptr<Task>
}

class TaskTemplates <<Prototype>> {
  {static} +instance() : TaskTemplates&
  +names() : vector<string>
  +createFrom(i) : unique_ptr<Task>
}

class TaskSnapshot {
  +capture(t : Task*) : TaskSnapshot
  +title/desc/priority/status/date/tags
}

class TaskList {
  +addTask(unique_ptr<Task>) : int
  +removeTask(id) : void
  +find(id) : Task*
  +all() : vector<unique_ptr<Task>>&
  +clear() : void
  +findBy(s) : vector<Task*>
  +sortedBy(s) : vector<Task*>
  +subscribe(o) / unsubscribe(o)
}

interface ITaskStorage <<Adapter>> {
  +save(list, path) : bool
  +load(list, path) : int
}

class TxtTaskStorage
class CsvTaskStorage
class FileStorage
class LegacyFileAdapter <<Adapter>>
class LegacyTodoAdapter <<Adapter>>

class AppSettings <<Singleton>> {
  {static} +instance() : AppSettings&
  +getPathToFile()/setPathToFile(...)
  +getFormat()/setFormat(f)
  +factory() : SettingsFactory
  +loadSettings()/saveSettings()
}

class AppConfig <<Singleton>> {
  {static} +instance() : AppConfig&
  +getAutoSave()/setAutoSave(v)
}

class TaskFlowFacade <<Facade>>

class Observer <<Observer>> {
  +update(event) : void
}
class AutoSaveObserver
class DeadlineObserver

interface SearchStrategy <<Strategy>>
interface SortStrategy <<Strategy>>
interface Command <<Command>>
class AddTaskCommand
class EditTaskCommand
class RemoveTaskCommand
class CommandHistory <<Invoker>>

Task <|-- RecurringTask
TaskFactory ..> Task : создаёт
TaskBuilder ..> Task : собирает
TaskTemplates ..> Task : копирует-прототип
TaskSnapshot ..> Task : снимок состояния
TaskList "1" o-- "0..*" Task : хранит unique_ptr
TaskList ..> SearchStrategy
TaskList ..> SortStrategy
TaskList o-- Observer : подписчики

ITaskStorage <|.. TxtTaskStorage
ITaskStorage <|.. CsvTaskStorage
ITaskStorage <|.. FileStorage
ITaskStorage <|.. LegacyFileAdapter
LegacyTodoAdapter ..> Task : импортирует

Command <|.. AddTaskCommand
Command <|.. EditTaskCommand
Command <|.. RemoveTaskCommand
AddTaskCommand ..> TaskBuilder
EditTaskCommand ..> TaskSnapshot
RemoveTaskCommand ..> Task : снимок (clone)
CommandHistory o-- Command
Observer <|.. AutoSaveObserver
Observer <|.. DeadlineObserver

TaskFlowFacade o-- TaskList
TaskFlowFacade o-- CommandHistory
TaskFlowFacade ..> AppSettings
TaskFlowFacade ..> AppConfig
TaskFlowFacade ..> ITaskStorage
TaskFlowFacade ..> LegacyFileAdapter
TaskFlowFacade ..> LegacyTodoAdapter
TaskFlowFacade ..> TaskTemplates
@enduml
