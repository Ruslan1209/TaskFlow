@startuml 04_seq_add
title Диаграмма последовательности: "Добавить задачу"

actor Пользователь as U
participant ":Menu\n(main.cpp)" as M
participant "f: TaskFactory" as F
participant "t: Task" as T
participant ":TaskList" as L
participant "s: ITaskStorage" as S

U -> M : выбрать пункт «Добавить задачу»
activate M
M -> M : ввод названия, типа, описания,\nдаты, приоритета, тегов
alt [данные верные: название не пустое,\nприоритет 1..3, дата в формате ДД.ММ.ГГГГ]
  M -> F : create(тип)
  F --> M : t : Task
  M -> T : setTitle(название)
  M -> T : setDescription(описание)
  M -> T : setDate(дата)
  M -> T : setPriority(приоритет)
  M -> T : setTags(теги)
  M -> L : addTask(t)
  activate L
  L --> M : задача принята
  deactivate L
  M -> S : save(список, путь к файлу)
  S --> M : истина
  M --> U : «Задача создана, номер N»
else [ошибка: пустое название]
  M --> U : «Ошибка: название не может быть пустым»
end
deactivate M
@enduml
